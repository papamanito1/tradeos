# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=tradeos
POSTGRES_PASSWORD=tradeos_secret
POSTGRES_DB=tradeos
DATABASE_URL=postgresql+asyncpg://tradeos:tradeos_secret@localhost:5432/tradeos

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Admin credentials (first-time seed) ────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123!

# ─── Trading Mode ────────────────────────────────────────────────────────────
# Options: paper | live
TRADING_MODE=live
# Set to 1 to allow live trading (requires explicit action in UI too)
ALLOW_LIVE_TRADING=1

# ─── Exchange (Binance Testnet) ───────────────────────────────────────────────
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true
# Set to 1 to use mock/paper mode (no real API calls)
USE_MOCK_EXCHANGE=1

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── X / Twitter Publishing (optional — agent posts trade signals & analysis) ─
# Cookie-based auth — free, bypasses all bot detection. One-time setup:
#   1. Log into x.com in Chrome as @tradeous
#   2. Press F12 → Application → Cookies → https://x.com
#   3. Copy "auth_token" value → X_AUTH_TOKEN
#   4. Copy "ct0" value        → X_CT0
X_AUTH_TOKEN=      # long hex string from x.com cookies
X_CT0=             # shorter string from x.com cookies

# ─── App Settings ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
